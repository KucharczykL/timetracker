{
  "registry": {
    "game": {
      "fields": ["name", "status", "year_released", "search", "session_count"],
      "relations": { "session_filter": "session" },
      "scopes": { "session_count": "session" }
    },
    "session": {
      "fields": ["device", "note"],
      "relations": { "game_filter": "game" },
      "scopes": {}
    },
    "purchase": {
      "fields": ["name"],
      "relations": {},
      "scopes": {}
    },
    "playthrough": {
      "fields": ["started", "completed", "days_to_finish", "note", "created_at"],
      "relations": { "game_filter": "game" },
      "scopes": {}
    }
  },
  "cases": [
    {
      "description": "single criterion",
      "model": "game",
      "filter": { "status": { "value": ["completed"], "modifier": "INCLUDES" } }
    },
    {
      "description": "canonical OR",
      "model": "game",
      "filter": {
        "OR": [
          { "status": { "value": ["completed"], "modifier": "INCLUDES" } },
          { "status": { "value": ["played"], "modifier": "INCLUDES" } }
        ]
      }
    },
    {
      "description": "mixed name OR status (faithful grouping)",
      "model": "game",
      "filter": {
        "name": { "value": "zelda", "modifier": "INCLUDES" },
        "OR": [{ "status": { "value": ["completed"], "modifier": "INCLUDES" } }]
      }
    },
    {
      "description": "OR with NOT",
      "model": "game",
      "filter": {
        "OR": [{ "status": { "value": ["completed"], "modifier": "INCLUDES" } }],
        "NOT": [{ "status": { "value": ["played"], "modifier": "INCLUDES" } }]
      }
    },
    {
      "description": "NOT of OR (De Morgan)",
      "model": "game",
      "filter": {
        "NOT": [
          {
            "OR": [
              { "status": { "value": ["completed"], "modifier": "INCLUDES" } },
              { "status": { "value": ["played"], "modifier": "INCLUDES" } }
            ]
          }
        ]
      }
    },
    {
      "description": "multi-child NOT",
      "model": "game",
      "filter": {
        "NOT": [
          { "status": { "value": ["completed"], "modifier": "INCLUDES" } },
          { "name": { "value": "x", "modifier": "INCLUDES" } }
        ]
      }
    },
    {
      "description": "relation ANY with child",
      "model": "game",
      "filter": {
        "session_filter": { "device": { "value": ["018f5e66-e800-7000-8000-000000000001"], "modifier": "INCLUDES" } }
      }
    },
    {
      "description": "relation NONE presence test",
      "model": "game",
      "filter": { "session_filter": { "match": "NONE" } }
    },
    {
      "description": "relation ANY presence test",
      "model": "game",
      "filter": { "session_filter": {} }
    },
    {
      "description": "field_comparisons precedence: (name OR status) AND comparison",
      "model": "game",
      "filter": {
        "name": { "value": "x", "modifier": "INCLUDES" },
        "OR": [ { "status": { "value": ["completed"], "modifier": "INCLUDES" } } ],
        "field_comparisons": [ { "left": "original_year_released", "right": "year_released", "modifier": "LESS_THAN" } ]
      }
    },
    {
      "description": "relation ALL quantifier",
      "model": "game",
      "filter": { "session_filter": { "match": "ALL", "device": { "value": ["018f5e66-e800-7000-8000-000000000001"], "modifier": "INCLUDES" } } }
    },
    {
      "description": "negated relation (NOT EXISTS)",
      "model": "game",
      "filter": { "NOT": [ { "session_filter": { "device": { "value": ["018f5e66-e800-7000-8000-000000000001"], "modifier": "INCLUDES" } } } ] }
    },
    {
      "description": "nested relation: game -> session -> game criterion",
      "model": "game",
      "filter": {
        "session_filter": {
          "game_filter": { "name": { "value": "zelda", "modifier": "INCLUDES" } }
        }
      }
    },
    {
      "description": "scoped aggregate: session_count over deck sessions",
      "model": "game",
      "filter": {
        "session_count": {
          "value": 5,
          "modifier": "GREATER_THAN",
          "scope": { "device": { "value": ["018f5e66-e800-7000-8000-000000000001"], "modifier": "INCLUDES" } }
        }
      }
    },
    {
      "description": "negated scoped aggregate",
      "model": "game",
      "filter": {
        "NOT": [
          {
            "session_count": {
              "value": 0,
              "modifier": "EQUALS",
              "scope": { "device": { "value": ["018f5e66-e800-7000-8000-000000000001"], "modifier": "INCLUDES" } }
            }
          }
        ]
      }
    },
    {
      "description": "scoped aggregate with inner OR scope",
      "model": "game",
      "filter": {
        "session_count": {
          "value": 2,
          "modifier": "GREATER_THAN",
          "scope": {
            "OR": [
              { "device": { "value": ["018f5e66-e800-7000-8000-000000000001"], "modifier": "INCLUDES" } },
              { "note": { "value": "docked", "modifier": "INCLUDES" } }
            ]
          }
        }
      }
    },
    {
      "description": "scoped aggregate with empty scope normalizes to unscoped",
      "model": "game",
      "filter": { "session_count": { "value": 1, "modifier": "EQUALS", "scope": {} } }
    },
    {
      "description": "session year-space: timestamp_start year vs game__year_released",
      "model": "session",
      "filter": {
        "field_comparisons": [
          { "left": "timestamp_start", "right": "game__year_released", "modifier": "EQUALS", "granularity": "year" }
        ]
      }
    },
    {
      "description": "session both-sides paths: game__name vs device__name (raw string)",
      "model": "session",
      "filter": {
        "field_comparisons": [
          { "left": "game__name", "right": "device__name", "modifier": "EQUALS" }
        ]
      }
    },
    {
      "description": "purchase: name INCLUDES related_game__name",
      "model": "purchase",
      "filter": {
        "field_comparisons": [
          { "left": "name", "right": "related_game__name", "modifier": "INCLUDES" }
        ]
      }
    },
    {
      "description": "playthrough date-space: started vs created_at (date-vs-datetime)",
      "model": "playthrough",
      "filter": {
        "started": { "value": "2025-03-15", "modifier": "EQUALS" },
        "created_at": { "value": "2025-03-15", "modifier": "EQUALS" }
      }
    },
    {
      "description": "playthrough endpoints: completed between, days greater than",
      "model": "playthrough",
      "filter": {
        "completed": { "value": "2025-01-01", "value2": "2025-12-31", "modifier": "BETWEEN" },
        "days_to_finish": { "value": 3, "modifier": "GREATER_THAN" }
      }
    },
    {
      "description": "playthrough relation: runs at games matching a name",
      "model": "playthrough",
      "filter": {
        "game_filter": { "name": { "value": "zelda", "modifier": "INCLUDES" } }
      }
    },
    {
      "description": "a percent in a text criterion survives the serializer",
      "model": "playthrough",
      "filter": { "note": { "value": "100% run", "modifier": "INCLUDES" } }
    },
    {
      "description": "multivalued comparison ANY: session end vs game__purchases__date_purchased (date)",
      "model": "session",
      "filter": {
        "field_comparisons": [
          { "left": "timestamp_end", "right": "game__purchases__date_purchased", "modifier": "GREATER_THAN", "granularity": "date" }
        ]
      }
    },
    {
      "description": "multivalued comparison ALL: session end vs game__purchases__date_purchased (date)",
      "model": "session",
      "filter": {
        "field_comparisons": [
          { "left": "timestamp_end", "right": "game__purchases__date_purchased", "modifier": "GREATER_THAN", "granularity": "date", "quantifier": "ALL" }
        ]
      }
    },
    {
      "description": "multivalued comparison NONE: session end vs game__purchases__date_purchased (date)",
      "model": "session",
      "filter": {
        "field_comparisons": [
          { "left": "timestamp_end", "right": "game__purchases__date_purchased", "modifier": "GREATER_THAN", "granularity": "date", "quantifier": "NONE" }
        ]
      }
    },
    {
      "description": "multivalued comparison raw M2M: purchase name INCLUDES games__name (ALL)",
      "model": "purchase",
      "filter": {
        "field_comparisons": [
          { "left": "name", "right": "games__name", "modifier": "INCLUDES", "quantifier": "ALL" }
        ]
      }
    }
  ]
}
